{
  "name": "dsh-sort-out-the-thoughts",
  "version": "0.3.10",
  "type": "module",
  "description": "对话里一个开关进入梳理模式；按「梳理 → 批判 → 调研」三段把模糊想法推成成稿，按体裁存档在 设置 → Thoughts Center。输入框旁另有「随想记录本」，碎灵感先存着，一键开梳。",
  "author": "hulibuld (https://github.com/hulibuld)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hulibuld/dsh-sort-out-the-thoughts.git"
  },
  "homepage": "https://github.com/hulibuld/dsh-sort-out-the-thoughts#readme",
  "bugs": {
    "url": "https://github.com/hulibuld/dsh-sort-out-the-thoughts/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "socratic",
    "writing",
    "brainstorm"
  ],
  "license": "MIT",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
